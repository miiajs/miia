  "src/user-profile/user-profile.controller.ts": 
"import { Controller, Delete, Get, inject, Patch, Post, type RequestContext, Status } from '@miiajs/core'
import { UserProfileService } from './user-profile.service.js'
import { type UserProfileIdParams, UserProfileIdParamsSchema } from './schemas/user-profile-id-params.schema.js'
import { type CreateUserProfileInput, CreateUserProfileSchema } from './schemas/create-user-profile.schema.js'
import { type UpdateUserProfileInput, UpdateUserProfileSchema } from './schemas/update-user-profile.schema.js'

@Controller('/user-profile')
export class UserProfileController {
  private readonly userProfileService = inject(UserProfileService)

  @Post({ body: CreateUserProfileSchema })
  @Status(201)
  async create(ctx: RequestContext) {
    return this.userProfileService.create(await ctx.json<CreateUserProfileInput>())
  }

  @Get()
  findAll() {
    return this.userProfileService.findAll()
  }

  @Get(':id', { params: UserProfileIdParamsSchema })
  findOne(ctx: RequestContext) {
    return this.userProfileService.findOne((ctx.params as UserProfileIdParams).id)
  }

  @Patch(':id', { params: UserProfileIdParamsSchema, body: UpdateUserProfileSchema })
  async update(ctx: RequestContext) {
    const { id } = ctx.params as UserProfileIdParams
    return this.userProfileService.update(id, await ctx.json<UpdateUserProfileInput>())
  }

  // Without @Status(204) a null result answers 200 with an empty body
  @Delete(':id', { params: UserProfileIdParamsSchema })
  @Status(204)
  remove(ctx: RequestContext) {
    this.userProfileService.remove((ctx.params as UserProfileIdParams).id)
    return null
  }
}
"
,
  "src/user-profile/user-profile.module.ts": 
"import { Module } from '@miiajs/core'
import { UserProfileController } from './user-profile.controller.js'
import { UserProfileService } from './user-profile.service.js'

@Module({
  controllers: [UserProfileController],
  providers: [UserProfileService],
  exports: [UserProfileService],
})
export class UserProfileModule {}
"
,
  "src/user-profile/user-profile.service.ts": 
"import { Injectable, NotFoundException } from '@miiajs/core'
import type { UserProfile } from './user-profile.types.js'
import type { CreateUserProfileInput } from './schemas/create-user-profile.schema.js'
import type { UpdateUserProfileInput } from './schemas/update-user-profile.schema.js'

// In-memory store: replace it with your database
@Injectable()
export class UserProfileService {
  private readonly items = new Map<string, UserProfile>()

  create(input: CreateUserProfileInput): UserProfile {
    const item = { id: crypto.randomUUID(), ...input }
    this.items.set(item.id, item)
    return item
  }

  findAll(): UserProfile[] {
    return [...this.items.values()]
  }

  findOne(id: string): UserProfile {
    const item = this.items.get(id)
    if (!item) throw new NotFoundException(\`UserProfile \${id} not found\`)
    return item
  }

  update(id: string, input: UpdateUserProfileInput): UserProfile {
    const item = { ...this.findOne(id), ...input }
    this.items.set(id, item)
    return item
  }

  remove(id: string): void {
    this.findOne(id)
    this.items.delete(id)
  }
}
"
,
  "src/user-profile/user-profile.test.ts": 
"import { describe, expect, it } from 'bun:test'
import { TestApp } from '@miiajs/testing'
import { UserProfileModule } from './user-profile.module.js'

const createApp = () => TestApp.create(UserProfileModule).compile()

describe('UserProfileController', () => {
  // One app for the whole flow: items live in the app instance
  it('creates, lists, reads, updates and deletes', async () => {
    const app = await createApp()
    try {
      const created = await app.request('POST', '/user-profile', { body: { name: 'First' } })
      expect(created.status).toBe(201)
      const { id } = await created.json()

      const list = await app.request('GET', '/user-profile')
      expect(await list.json()).toEqual([{ id, name: 'First' }])

      const found = await app.request('GET', \`/user-profile/\${id}\`)
      expect(found.status).toBe(200)
      expect(await found.json()).toEqual({ id, name: 'First' })

      const updated = await app.request('PATCH', \`/user-profile/\${id}\`, { body: { name: 'Renamed' } })
      expect(await updated.json()).toEqual({ id, name: 'Renamed' })

      const removed = await app.request('DELETE', \`/user-profile/\${id}\`)
      expect(removed.status).toBe(204)
      expect((await app.request('GET', \`/user-profile/\${id}\`)).status).toBe(404)
    } finally {
      await app.close()
    }
  })

  it('answers 404 for a missing item and 422 for an invalid id or body', async () => {
    const app = await createApp()
    try {
      expect((await app.request('GET', \`/user-profile/\${crypto.randomUUID()}\`)).status).toBe(404)
      expect((await app.request('GET', '/user-profile/999')).status).toBe(422)
      expect((await app.request('POST', '/user-profile', { body: { name: '' } })).status).toBe(422)
    } finally {
      await app.close()
    }
  })
})
"
,
  "src/user-profile/user-profile.types.ts": 
"export interface UserProfile {
  id: string
  name: string
}
"
,
}
`;

exports[`miia g table drizzle-postgres: the table, its line in the schema barrel and the next steps 1`] = `
"import { pgTable, text, timestamp, uuid } from 'drizzle-orm/pg-core'

export const userProfile = pgTable('user_profile', {
  id: uuid('id').primaryKey().defaultRandom(),
  name: text('name').notNull(),
  createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
  updatedAt: timestamp('updated_at', { withTimezone: true })
    .notNull()
    .defaultNow()
    .$onUpdate(() => new Date()),
})

export type UserProfile = typeof userProfile.$inferSelect
export type NewUserProfile = typeof userProfile.$inferInsert
"
`;

