      expect((await me.json()).email).toBe(credentials.email)
    } finally {
      await app.close()
    }
  })

  it('rejects /auth/me without a token', async () => {
    const app = await createApp()
    try {
      const res = await app.request('GET', '/auth/me')
      expect(res.status).toBe(401)
    } finally {
      await app.close()
    }
  })
})
"
,
  "src/users/users.model.ts": 
"import { defineModel } from '@miiajs/mongoose'
import { Schema } from 'mongoose'

interface UserDocument {
  email: string
  passwordHash: string
}

export const UsersModel = defineModel<UserDocument>(
  'User',
  new Schema<UserDocument>(
    {
      email: { type: String, required: true, unique: true },
      passwordHash: { type: String, required: true },
    },
    { timestamps: true },
  ),
)
"
,
  "src/users/users.module.ts": 
"import { Module } from '@miiajs/core'
import { MongooseModule } from '@miiajs/mongoose'
import { UsersModel } from './users.model.js'
import { UsersService } from './users.service.js'

@Module({
  imports: [MongooseModule.register([UsersModel])],
  providers: [UsersService],
  exports: [UsersService],
})
export class UsersModule {}
"
,
  "src/users/users.service.ts": 
"import { Injectable, inject } from '@miiajs/core'
import { isValidObjectId, type Types } from 'mongoose'
import { UsersModel } from './users.model.js'
import type { StoredUser, User } from './users.types.js'

@Injectable()
export class UsersService {
  private readonly users = inject(UsersModel)

  async findById(id: string): Promise<User | undefined> {
    if (!isValidObjectId(id)) return undefined
    const user = await this.users.findById(id)
    return user ? toUser(user) : undefined
  }

  async findByEmail(email: string): Promise<User | undefined> {
    const user = await this.users.findOne({ email })
    return user ? toUser(user) : undefined
  }

  async findByEmailForAuth(email: string): Promise<StoredUser | undefined> {
    const user = await this.users.findOne({ email })
    return user ? { ...toUser(user), passwordHash: user.passwordHash } : undefined
  }

  async create(data: { email: string; passwordHash: string }): Promise<User> {
    return toUser(await this.users.create(data))
  }
}

function toUser(doc: { _id: Types.ObjectId; email: string }): User {
  return { id: String(doc._id), email: doc.email }
}
"
,
  "src/users/users.types.ts": 
"export interface User {
  id: string
  email: string
}

export interface StoredUser extends User {
  passwordHash: string
}
"
,
}
