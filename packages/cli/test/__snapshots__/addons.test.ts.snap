exports[`add-ons combine into one project 1`] = `
"import { ConfigModule, ConfigService } from '@miiajs/config'
import { Module } from '@miiajs/core'
import { envSchema, type Env } from '../env.schema.js'
import { AppController } from './app.controller.js'
import { AppService } from './app.service.js'
import { JwtModule } from '@miiajs/jwt'
import { AuthModule } from '../auth/auth.module.js'
import { SwaggerModule } from '@miiajs/swagger'
import { RateLimitModule } from '@miiajs/rate-limit'
import { DrizzleModule } from '@miiajs/drizzle'
import * as schema from '../db/schema.js'

@Module({
  imports: [
    ConfigModule.configure({ schema: envSchema }, { global: true }),
    JwtModule.configure(
      (resolve) => ({
        secret: resolve<ConfigService<Env>>(ConfigService).getOrThrow('JWT_SECRET'),
        expiresIn: '1h',
      }),
      { global: true },
    ),
    AuthModule,
    SwaggerModule.configure({ title: 'demo-app', version: '0.1.0' }),
    RateLimitModule.configure({ limit: 100, window: '1m' }, { global: true }),
    DrizzleModule.configure(
      (resolve) => ({
        dialect: 'sqlite',
        connection: { url: resolve<ConfigService<Env>>(ConfigService).getOrThrow('DATABASE_URL') },
        schema,
      }),
      { global: true },
    ),
  ],
  controllers: [AppController],
  providers: [AppService],
})
export class AppModule {}
"
`;

exports[`add-ons combine into one project 2`] = `
"import { ConfigService } from '@miiajs/config'
import { Miia, cors } from '@miiajs/core'
import { AppModule } from './app/app.module.js'
import type { Env } from './env.schema.js'
import { serveStatic } from '@miiajs/serve-static'
import { RateLimitGuard } from '@miiajs/rate-limit'

const app = new Miia().register(AppModule)
const config = app.get<ConfigService<Env>>(ConfigService)

app.use(cors({ origin: config.get('CORS_ORIGIN') }))
serveStatic(app, '/static', './public')
app.useGuard(RateLimitGuard)
await app.listen(config.get('PORT'), config.get('HOST'))
"
`;

exports[`add-ons combine into one project 3`] = `
"import { z } from 'zod'

export const envSchema = z.object({
  NODE_ENV: z.enum(['development', 'production', 'test']).default('development'),
  HOST: z.string().default('0.0.0.0'),
  PORT: z.coerce.number().int().min(1).max(65535).default(3000),
  JWT_SECRET: z.string().min(32),
  CORS_ORIGIN: z.string().default('*'),
  DATABASE_URL: z.string(),
})

export type Env = z.infer<typeof envSchema>
"
`;
