    "@miiajs/config": "^0.0.0-test",
    "@miiajs/core": "^0.0.0-test",
    "@miiajs/rate-limit": "^0.0.0-test",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@miiajs/cli": "^0.0.0-test",
    "@miiajs/testing": "^0.0.0-test",
    "@types/bun": "^1.4.0",
    "typescript": "^6.0.2"
  },
  "scripts": {
    "dev": "miia dev --runtime bun",
    "build": "miia build --runtime bun",
    "start": "miia start --runtime bun",
    "check": "miia check",
    "test": "bun test"
  }
}
"
,
  "src/app/app.module.ts": 
"import { ConfigModule } from '@miiajs/config'
import { Module } from '@miiajs/core'
import { envSchema } from '../env.schema.js'
import { AppController } from './app.controller.js'
import { AppService } from './app.service.js'
import { RateLimitModule } from '@miiajs/rate-limit'

@Module({
  imports: [ConfigModule.configure({ schema: envSchema }, { global: true }), RateLimitModule.configure({ limit: 100, window: '1m' }, { global: true })],
  controllers: [AppController],
  providers: [AppService],
})
export class AppModule {}
"
,
  "src/main.ts": 
"import { ConfigService } from '@miiajs/config'
import { Miia } from '@miiajs/core'
import { AppModule } from './app/app.module.js'
import type { Env } from './env.schema.js'
import { RateLimitGuard } from '@miiajs/rate-limit'

const app = new Miia().register(AppModule)
const config = app.get<ConfigService<Env>>(ConfigService)

app.useGuard(RateLimitGuard)
await app.listen(config.get('PORT'), config.get('HOST'))
"
,
}
`;

