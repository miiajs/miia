exports[`add-ons drizzle-postgres on bun 1`] = `
{
  ".env": 
"HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/demo_app
"
,
  ".env.example": 
"HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/demo_app
"
,
  "README.md": 
"# demo-app

A [MiiaJS](https://miiajs.com) app.

## Scripts

| Command | What it does |
| --- | --- |
| \`bun run dev\` | Dev server with reload and type-checking |
| \`bun run test\` | Tests (\`src/**/*.test.ts\`) |
| \`bun run check\` | Type-check |
| \`bun run build\` | Build |
| \`bun run start\` | Production server |

## Configuration

Environment variables are validated by \`src/env.schema.ts\` and read through \`ConfigService\`. \`.env.example\` lists every variable, with a value where it is safe to share; secrets such as \`JWT_SECRET\` stay empty there, and the app does not start until you set them. \`.env\` holds your local values (secrets generated when the project was created) and is not committed. \`NODE_ENV\` is set by the scripts: \`development\` for \`dev\`, \`production\` for \`start\`.

## Database

The app connects to \`DATABASE_URL\` in \`.env\`, by default \`postgres://postgres:postgres@localhost:5432/demo_app\`.

Start PostgreSQL with a \`demo_app\` database, for example in Docker:

\`\`\`bash
docker run -d --name demo_app-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=demo_app -p 5432:5432 postgres:17
\`\`\`

Or create it in a PostgreSQL you already run (\`createdb demo_app\`), or set \`DATABASE_URL\` to another database. Then start the app:

\`\`\`bash
bun run dev
\`\`\`

Add a table, then create it in the database:

\`\`\`bash
bunx miia g table posts
bun run db:generate
bun run db:migrate
\`\`\`

\`miia g table\` writes \`src/posts/posts.table.ts\` and adds it to \`src/db.schema.ts\`, \`db:generate\` writes SQL migrations for that schema to \`drizzle/\`, \`db:migrate\` applies them. Run both again after changing a table.

In a service next to the table, inject the typed handle from \`src/db.ts\`:

\`\`\`ts
import { Injectable, inject } from '@miiajs/core'
import { db } from '../db.js'
import { posts } from './posts.table.js'

@Injectable()
export class PostsService {
  private readonly db = inject(db)

  findAll() {
    return this.db.select().from(posts)
  }
}
\`\`\`

## Next steps

- \`bunx miia g resource posts\` - a CRUD module with route schemas and a test
- \`bunx miia add swagger\` - OpenAPI docs at \`/docs\`
- Docs: https://miiajs.com/docs
"
,
  "drizzle.config.ts": 
"import { defineConfig } from 'drizzle-kit'

// npm run and deno task do not load .env, and drizzle-kit needs DATABASE_URL
try {
  process.loadEnvFile()
} catch {
  // no .env: DATABASE_URL comes from the environment
}

export default defineConfig({
  dialect: 'postgresql',
  schema: './src/db.schema.ts',
  out: './drizzle',
  dbCredentials: { url: process.env.DATABASE_URL! },
})
"
,
  "package.json": 
"{
  "name": "demo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@miiajs/config": "^0.0.0-test",
    "@miiajs/core": "^0.0.0-test",
    "@miiajs/drizzle": "^0.0.0-test",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@miiajs/cli": "^0.0.0-test",
    "@miiajs/testing": "^0.0.0-test",
    "@types/bun": "^1.4.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.2"
  },
  "scripts": {
    "dev": "miia dev --runtime bun",
    "build": "miia build --runtime bun",
    "start": "miia start --runtime bun",
    "check": "miia check",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  }
}
"
,
  "src/app/app.module.ts": 
"import { ConfigModule, ConfigService } from '@miiajs/config'
import { Module } from '@miiajs/core'
import { envSchema, type Env } from '../env.schema.js'
import { AppController } from './app.controller.js'
import { AppService } from './app.service.js'
import { DrizzleModule } from '@miiajs/drizzle'
import * as schema from '../db.schema.js'

@Module({
  imports: [
    ConfigModule.configure({ schema: envSchema }, { global: true }),
    DrizzleModule.configure(
      (resolve) => ({
        dialect: 'postgres',
        connection: { url: resolve<ConfigService<Env>>(ConfigService).getOrThrow('DATABASE_URL') },
        schema,
      }),
      { global: true },
    ),
  ],
  controllers: [AppController],
  providers: [AppService],
})
export class AppModule {}
"
,
  "src/db.schema.ts": 
"// Every table, for DrizzleModule and \`typeof schema\` in db.ts: \`miia g table <name>\` adds a line here
export {}
"
,
  "src/db.ts": 
"import { drizzleDb } from '@miiajs/drizzle'
import type { PostgresJsDatabase } from 'drizzle-orm/postgres-js'
import type * as schema from './db.schema.js'

// The one typed handle: inject(db) everywhere, do not call drizzleDb<...>() again
export const db = drizzleDb<PostgresJsDatabase<typeof schema>>()
"
,
  "src/env.schema.ts": 
"import { z } from 'zod'

export const envSchema = z.object({
  NODE_ENV: z.enum(['development', 'production', 'test']).default('development'),
  HOST: z.string().default('0.0.0.0'),
