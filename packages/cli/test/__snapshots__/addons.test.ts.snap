exports[`add-ons drizzle-postgres on bun 1`] = `
{
  ".env": 
"NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/demo_app
"
,
  ".env.example": 
"NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/demo_app
"
,
  "drizzle.config.ts": 
"import { defineConfig } from 'drizzle-kit'

// npm run and deno task do not load .env, and drizzle-kit needs DATABASE_URL
try {
  process.loadEnvFile()
} catch {
  // no .env: DATABASE_URL comes from the environment
}

export default defineConfig({
  dialect: 'postgresql',
  schema: './src/db/schema.ts',
  out: './drizzle',
  dbCredentials: { url: process.env.DATABASE_URL! },
})
"
,
  "package.json": 
"{
  "name": "demo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@miiajs/config": "^0.0.0-test",
    "@miiajs/core": "^0.0.0-test",
    "@miiajs/drizzle": "^0.0.0-test",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@miiajs/cli": "^0.0.0-test",
    "@miiajs/testing": "^0.0.0-test",
    "@types/bun": "^1.4.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.2"
  },
  "scripts": {
    "dev": "miia dev --runtime bun",
    "build": "miia build --runtime bun",
    "start": "miia start --runtime bun",
    "check": "miia check",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  }
}
"
,
  "src/app/app.module.ts": 
"import { ConfigModule, ConfigService } from '@miiajs/config'
import { Module } from '@miiajs/core'
import { envSchema, type Env } from '../env.schema.js'
import { AppController } from './app.controller.js'
import { AppService } from './app.service.js'
import { DrizzleModule } from '@miiajs/drizzle'
import * as schema from '../db/schema.js'

@Module({
  imports: [
    ConfigModule.configure({ schema: envSchema }, { global: true }),
    DrizzleModule.configure(
      (resolve) => ({
        dialect: 'postgres',
        connection: { url: resolve<ConfigService<Env>>(ConfigService).getOrThrow('DATABASE_URL') },
        schema,
      }),
      { global: true },
    ),
  ],
  controllers: [AppController],
  providers: [AppService],
})
export class AppModule {}
"
,
  "src/db/db.ts": 
"import { drizzleDb } from '@miiajs/drizzle'
import type { PostgresJsDatabase } from 'drizzle-orm/postgres-js'
import type * as schema from './schema.js'

// The one typed handle: inject(db) everywhere, do not call drizzleDb<...>() again
export const db = drizzleDb<PostgresJsDatabase<typeof schema>>()
"
,
  "src/db/schema.ts": 
"import { pgTable, serial, text, timestamp } from 'drizzle-orm/pg-core'

export const notes = pgTable('notes', {
  id: serial('id').primaryKey(),
  title: text('title').notNull(),
  createdAt: timestamp('created_at').notNull().defaultNow(),
})
"
,
  "src/env.schema.ts": 
"import { z } from 'zod'

export const envSchema = z.object({
  NODE_ENV: z.enum(['development', 'production', 'test']).default('development'),
  HOST: z.string().default('0.0.0.0'),
  PORT: z.coerce.number().int().min(1).max(65535).default(3000),
  DATABASE_URL: z.string(),
})

export type Env = z.infer<typeof envSchema>
"
,
}
`;

