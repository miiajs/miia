  "src/auth/auth.schemas.ts": 
"import { z } from 'zod'

export const LoginSchema = z.object({
  email: z.email(),
  password: z.string().min(1),
})

export const RegisterSchema = z.object({
  email: z.email(),
  password: z.string().min(8),
})

export type LoginInput = z.infer<typeof LoginSchema>
export type RegisterInput = z.infer<typeof RegisterSchema>
"
,
  "src/auth/auth.service.ts": 
"import { ConflictException, Injectable, inject } from '@miiajs/core'
import { JwtService } from '@miiajs/jwt'
import { type User, UsersService } from '../users/users.service.js'
import type { RegisterInput } from './auth.schemas.js'
import { hashPassword } from './password.js'

@Injectable()
export class AuthService {
  private readonly usersService = inject(UsersService)
  private readonly jwtService = inject(JwtService)

  async register({ email, password }: RegisterInput) {
    if (await this.usersService.findByEmail(email)) {
      throw new ConflictException('Email is already registered')
    }
    const user = await this.usersService.create({ email, passwordHash: await hashPassword(password) })
    return this.issueTokenFor(user)
  }

  async issueTokenFor(user: User) {
    return { accessToken: await this.jwtService.sign({ sub: String(user.id), email: user.email }) }
  }
}
"
,
  "src/auth/auth.test.ts": 
"import { describe, expect, it } from 'bun:test'
import { JwtModule } from '@miiajs/jwt'
import { TestApp } from '@miiajs/testing'
import { AuthModule } from './auth.module.js'

const createApp = () =>
  TestApp.create(
    JwtModule.configure({ secret: 'test-secret-that-is-at-least-32-chars' }, { global: true }),
    AuthModule,
  ).compile()

describe('auth', () => {
  // One app for the whole flow: users live in the app instance
  it('registers, logs in and reads the current user', async () => {
    const app = await createApp()
    try {
      const credentials = { email: 'ada@example.com', password: 'correct-horse' }

      const registered = await app.request('POST', '/auth/register', { body: credentials })
      expect(registered.status).toBe(201)
      expect(typeof (await registered.json()).accessToken).toBe('string')

      const again = await app.request('POST', '/auth/register', { body: credentials })
      expect(again.status).toBe(409)

      const login = await app.request('POST', '/auth/login', { body: credentials })
      expect(login.status).toBe(200)
      const { accessToken } = await login.json()

      const wrong = await app.request('POST', '/auth/login', { body: { ...credentials, password: 'wrong-password' } })
      expect(wrong.status).toBe(401)

      const me = await app.request('GET', '/auth/me', { headers: { authorization: \`Bearer \${accessToken}\` } })
      expect(me.status).toBe(200)
      expect((await me.json()).email).toBe(credentials.email)
    } finally {
      await app.close()
    }
  })

  it('rejects /auth/me without a token', async () => {
    const app = await createApp()
    try {
      const res = await app.request('GET', '/auth/me')
      expect(res.status).toBe(401)
    } finally {
      await app.close()
    }
  })
})
"
,
  "src/auth/password.ts": 
"export function hashPassword(password: string): Promise<string> {
  return Bun.password.hash(password)
}

export function verifyPassword(password: string, hash: string): Promise<boolean> {
  return Bun.password.verify(password, hash)
}
"
,
  "src/auth/providers/jwt-auth.provider.ts": 
"import { type AuthProvider, fromHeader } from '@miiajs/auth'
import { Injectable, inject, type RequestContext, UnauthorizedException } from '@miiajs/core'
import { JwtService } from '@miiajs/jwt'
import { UsersService } from '../../users/users.service.js'

@Injectable()
export class JwtAuth implements AuthProvider {
  private readonly jwtService = inject(JwtService)
  private readonly usersService = inject(UsersService)
  private readonly extract = fromHeader()

  async authenticate(ctx: RequestContext) {
    const token = this.extract(ctx)
    if (!token) {
      throw new UnauthorizedException('Missing token')
    }
    const payload = await this.jwtService.verify<{ sub: string }>(token).catch(() => {
      throw new UnauthorizedException('Invalid token')
    })

    const user = await this.usersService.findById(Number(payload.sub))
    if (!user) throw new UnauthorizedException('User not found')
    return user
  }
}
"
,
  "src/auth/providers/local-auth.provider.ts": 
"import type { AuthProvider } from '@miiajs/auth'
import { Injectable, inject, type RequestContext, UnauthorizedException } from '@miiajs/core'
import { UsersService } from '../../users/users.service.js'
import { LoginSchema } from '../auth.schemas.js'
import { verifyPassword } from '../password.js'

@Injectable()
export class LocalAuth implements AuthProvider {
  private readonly usersService = inject(UsersService)

  async authenticate(ctx: RequestContext) {
    const parsed = LoginSchema.safeParse(await ctx.json().catch(() => null))
    if (!parsed.success) {
      throw new UnauthorizedException('Invalid credentials payload')
    }
    const { email, password } = parsed.data

    const found = await this.usersService.findByEmailForAuth(email)
    if (!found || !(await verifyPassword(password, found.passwordHash))) {
      throw new UnauthorizedException('Invalid credentials')
    }
    return { id: found.id, email: found.email }
  }
}
"
,
  "src/env.schema.ts": 
"import { z } from 'zod'

export const envSchema = z.object({
  NODE_ENV: z.enum(['development', 'production', 'test']).default('development'),
  HOST: z.string().default('0.0.0.0'),
  PORT: z.coerce.number().int().min(1).max(65535).default(3000),
  JWT_SECRET: z.string().min(32),
})

export type Env = z.infer<typeof envSchema>
"
