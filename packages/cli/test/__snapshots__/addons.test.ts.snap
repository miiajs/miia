  PORT: z.coerce.number().int().min(1).max(65535).default(3000),
  MONGODB_URL: z.string(),
})

export type Env = z.infer<typeof envSchema>
"
,
}
`;

exports[`add-ons jwt-auth with a database keeps users in drizzle-postgres 1`] = `
{
  "src/auth/auth.test.ts": 
"import { describe, expect, it } from 'bun:test'
import { JwtModule } from '@miiajs/jwt'
import { TestApp } from '@miiajs/testing'
import { UsersService } from '../users/users.service.js'
import type { StoredUser, User } from '../users/users.types.js'
import { AuthModule } from './auth.module.js'

// UsersService over a Map: this test needs no database
function fakeUsers() {
  const users = new Map<string, StoredUser>()
  const toUser = ({ id, email }: StoredUser): User => ({ id, email })
  const findByEmailForAuth = async (email: string) => [...users.values()].find((user) => user.email === email)
  return {
    findByEmailForAuth,
    findById: async (id: string) => {
      const user = users.get(id)
      return user && toUser(user)
    },
    findByEmail: async (email: string) => {
      const user = await findByEmailForAuth(email)
      return user && toUser(user)
    },
    create: async (data: { email: string; passwordHash: string }) => {
      const now = new Date()
      const user = { id: crypto.randomUUID(), ...data, createdAt: now, updatedAt: now }
      users.set(user.id, user)
      return toUser(user)
    },
  }
}

const createApp = () =>
  TestApp.create(JwtModule.configure({ secret: 'test-secret-that-is-at-least-32-chars' }, { global: true }), AuthModule)
    .override(UsersService, fakeUsers())
    .compile()

describe('auth', () => {
  // One app for the whole flow: the fake keeps users in the app instance
  it('registers, logs in and reads the current user', async () => {
    const app = await createApp()
    try {
      const credentials = { email: 'ada@example.com', password: 'correct-horse' }

      const registered = await app.request('POST', '/auth/register', { body: credentials })
      expect(registered.status).toBe(201)
      expect(typeof (await registered.json()).accessToken).toBe('string')

      const again = await app.request('POST', '/auth/register', { body: credentials })
      expect(again.status).toBe(409)

      const login = await app.request('POST', '/auth/login', { body: credentials })
      expect(login.status).toBe(200)
      const { accessToken } = await login.json()

      const wrong = await app.request('POST', '/auth/login', { body: { ...credentials, password: 'wrong-password' } })
      expect(wrong.status).toBe(401)

      const me = await app.request('GET', '/auth/me', { headers: { authorization: \`Bearer \${accessToken}\` } })
      expect(me.status).toBe(200)
      expect((await me.json()).email).toBe(credentials.email)
    } finally {
      await app.close()
    }
  })

  it('rejects /auth/me without a token', async () => {
    const app = await createApp()
    try {
      const res = await app.request('GET', '/auth/me')
      expect(res.status).toBe(401)
    } finally {
      await app.close()
    }
  })
})
"
,
  "src/db.schema.ts": 
"// Every table, for DrizzleModule and \`typeof schema\` in db.ts: \`miia g table <name>\` adds a line here
export * from './users/users.table.js'
"
,
  "src/users/users.module.ts": 
"import { Module } from '@miiajs/core'
import { UsersService } from './users.service.js'

@Module({
  providers: [UsersService],
  exports: [UsersService],
})
export class UsersModule {}
"
,
  "src/users/users.service.ts": 
"import { Injectable, inject } from '@miiajs/core'
import { eq } from 'drizzle-orm'
import { db } from '../db.js'
import { users } from './users.table.js'
import type { StoredUser, User } from './users.types.js'

const publicColumns = { id: users.id, email: users.email }

@Injectable()
export class UsersService {
  private readonly db = inject(db)

  async findById(id: string): Promise<User | undefined> {
    const [user] = await this.db.select(publicColumns).from(users).where(eq(users.id, id)).limit(1)
    return user
  }

  async findByEmail(email: string): Promise<User | undefined> {
    const [user] = await this.db.select(publicColumns).from(users).where(eq(users.email, email)).limit(1)
    return user
  }

  async findByEmailForAuth(email: string): Promise<StoredUser | undefined> {
    const [user] = await this.db.select().from(users).where(eq(users.email, email)).limit(1)
    return user
  }

  // Insert, then select: MySQL has no RETURNING
  async create(data: { email: string; passwordHash: string }): Promise<User> {
    await this.db.insert(users).values(data)
    const [user] = await this.db.select(publicColumns).from(users).where(eq(users.email, data.email)).limit(1)
    return user as User
  }
}
"
,
  "src/users/users.table.ts": 
"import { pgTable, text, timestamp, uuid } from 'drizzle-orm/pg-core'

export const users = pgTable('users', {
  id: uuid('id').primaryKey().defaultRandom(),
  email: text('email').notNull().unique(),
  passwordHash: text('password_hash').notNull(),
  createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
  updatedAt: timestamp('updated_at', { withTimezone: true })
    .notNull()
    .defaultNow()
    .$onUpdate(() => new Date()),
})
"
,
  "src/users/users.types.ts": 
"import type { users } from './users.table.js'

export type StoredUser = typeof users.$inferSelect
export type User = Pick<StoredUser, 'id' | 'email'>
"
,
}
`;

